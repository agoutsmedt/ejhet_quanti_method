@article{blackburnMacroeconomic1987,
  title = {Macroeconomic {{Policy Evaluation}} and {{Optimal Control Theory}}: {{A Critical Review}} of {{Some Recent Developments}}},
  shorttitle = {Macroeconomic {{Policy Evaluation}} and {{Optimal Control Theory}}},
  author = {Blackburn, Keith},
  year = {1987},
  month = mar,
  journal = {Journal of Economic Surveys},
  volume = {1},
  number = {1-2},
  pages = {111--148},
  issn = {1467-6419},
  doi = {10.1111/j.1467-6419.1987.tb00029.x},
  urldate = {2015-06-09},
  abstract = {Abstract.  This survey addresses the recent literature on the application of optimal control theory and game theory to macroeconomic policy evaluation and design. This literature focuses on strategic interactions between governments and private agents engaged in dynamic non-cooperative games and emphasizes such issues as precommitment, credibility and reputation as important and endemic aspects of optimal policy design. A dominant theme is the problem of dynamic inconsistency and the inferiority of an equilibrium in single-stage full-information games without commitment. This may be alleviated in repeated games involving reputation effects and threat strategies designed to coerce rivals into pursuing particular strategies and to sustain a sequential equilibrium. The type and characteristics of a sequential equilibrium also depend importantly upon the information structure conditioning players'beliefs under uncertainty. Included here are separating and pooling equilibria, involving notions of learning, signalling and information revelation. Additional dimensions exist in stochastic systems which introduce other forms of uncertainty. Optimal control and game theory have also been applied to international macroeconomic policy design, with emphasis on the potential costs and benefits of non-cooperative and cooperative behaviour between countries and problems of international policy coordination.},
  langid = {english},
  keywords = {Control_theory,Monetary_policy,Rational_Expectations,Time_inconsistency}
}

