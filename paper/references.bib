@article{helgadottirManaging2021,
  title = {Managing {{Macroeconomic Neoliberalism}}: {{Capital}} and the {{Resilience}} of the {{Rational Expectations Assumption}} since the {{Great Recession}}},
  shorttitle = {Managing {{Macroeconomic Neoliberalism}}},
  author = {Helgad{\'o}ttir, Oddn{\'y} and Ban, Cornel},
  year = {2021},
  month = jan,
  journal = {New Political Economy},
  pages = {1--16},
  issn = {1356-3467, 1469-9923},
  doi = {10.1080/13563467.2020.1863344},
  urldate = {2021-08-23},
  abstract = {There is little systematic work on how much the core of mainstream macroeconomics has changed since the crisis of 2008 and even less on what explains patterns of stability and change. This paper addresses this gap by first, mapping out debates over the core assumption of rational expectations in high-prestige academic publications and the research of central banks of systemic importance and second, deploying a sociological perspective to assess the various forms of capital deployed by orthodox defenders, radical challengers and constructive critics of this assumption. The paper finds that although the core of modern macro has seen a more robust radical challenge than one might have expect, the defense of rational expectations remained quantitatively dominant and substantively elastic. While radical challengers had access to significant material resources and symbolic capital, orthodox players control the institutions of the economics profession via editorial boards and refereeing for the top journals. As such, the orthodox exercise a strong gatekeeping function that allows some pluralism yet also goes some way toward explaining their continued intellectual dominance.},
  langid = {english},
  keywords = {-Lu,International_Political_Economy,Neoliberalism,political_science,Rational_Expectations}
}

@article{heninCompatibilite1984,
  title = {{Sur la compatibilit{\'e} {\`a} long terme d'un ajustement partiel des prix avec l'hypoth{\`e}se de pr{\'e}visions rationnelles}},
  author = {H{\'e}nin, Pierre-Yves and Zylberberg, Andr{\'e}},
  year = {1984},
  journal = {Revue D'{\'e}conomie Politique},
  volume = {94},
  number = {6},
  eprint = {24698864},
  eprinttype = {jstor},
  pages = {792--807},
  issn = {0373-2630},
  urldate = {2018-01-31},
  abstract = {Cet article {\'e}tudie les solutions stationnaires de long terme d'un mod{\`e}le d'inflation mon{\'e}taire du type Cagan lorsque les pr{\'e}visions sont parfaites (dans un cadre d{\'e}terministe cette hypoth{\`e}se est {\'e}quivalente {\`a} celle d'anticipations rationnelles) et o{\`u} les prix sont rigides. On discute les conclusions de Mussa (1980) et l'on montre, en supposant un ajustement optimal du prix {\`a} une cible flexible, que la solution de long terme est en g{\'e}n{\'e}ral une solution de quasi-{\'e}quilibre o{\`u} les exc{\`e}s de demande persistent ind{\'e}finiment. Comme dans tout mod{\`e}le coh{\'e}rent avec anticipations rationnelles, on montre cependant que les changements anticip{\'e}s de la politique {\'e}conomique future r{\'e}agissent sur l'inflation courante. The paper considers the long run stationnary solutions of a Cagan's type model of monetary inflation when expectations are perfect (i.e. the equivalent of rational expectations in a deterministic setting) but prices are sluggish. The conclusions of Mussa (1980) are discussed and it is shown, assuming optimal price adjustment to a flexible target, that the long run solution will generally be a quasi equilibrium one, with excess demand lasting for ever. Whenever, as in any consistent rational expectation model, any anticipated policy change in the future does affect current inflation.},
  langid = {french},
  keywords = {French_Macro,nosource,Rational_Expectations}
}

