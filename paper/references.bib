@article{seltenReexamination1975,
  title = {Reexamination of the Perfectness Concept for Equilibrium Points in Extensive Games},
  author = {Selten, R.},
  year = {1975},
  month = mar,
  journal = {International Journal of Game Theory},
  volume = {4},
  number = {1},
  pages = {25--55},
  issn = {0020-7276, 1432-1270},
  doi = {10.1007/BF01766400},
  urldate = {2025-09-05},
  abstract = {The concept of a perfect equilibrium point has been introduced in order to exclude the possibility that disequilibrium behavior is prescribed on unreached subgames. (Selten 1965 and 1973). Unfortunately this definition of perfectness does not remove all difficulties which may arise with respect to unreached parts of the game. It is necessary to reexamine the problem of defining a satisfactory non-cooperative equilibrium concept for games in extensive form. Therefore a new concept of a perfect equilibrium point will be introduced in this paper. In retrospect the earlier use of the word "perfect" was premature. Therefore a perfect equilibrium point in the old Sense will be called "subgame perfect". The new definition of perfectness has the property that a perfect equilibrium point is always subgame perfect but a subgame perfect equilibrium point may not be perfect. It will be shown that every finite extensive game with perfect recall has at least one perfect equilibrium point. Since subgame perfectness cannot be detected in the normal form, it is clear that for the purpose of the investigation of the problem of perfectness, the normal form is an inadequate representation of the extensive form. It will be convenient to introduce an "agent normal form" as a more adequate representation of games with perfect recall.},
  copyright = {http://www.springer.com/tdm},
  langid = {english}
}

@book{sentEvolving1998,
  title = {The {{Evolving Rationality}} of {{Rational Expectations}}: {{An Assessment}} of {{Thomas Sargent}}'s {{Achievements}}},
  shorttitle = {The {{Evolving Rationality}} of {{Rational Expectations}}},
  author = {Sent, Esther-Mirjam},
  year = {1998},
  publisher = {Cambridge University Press},
  abstract = {Inspired by recent developments in science studies, this book offers an innovative type of analysis of the recent history of rational expectations economics. In the course of exploring the multiple dimensions of rational expectations analysis, Professor Sent focuses on the work of Thomas Sargent, an instrumental pioneer in the development of this school of thought. The investigation attempts to avoid a Whiggish history that sees Sargent's development as inevitably progressing to better and better economic analysis. Instead, it provides an illustration of what happened to the approach through a contextualization of Sargent's work vis--vis that of other scholars and ideas. The treatment aims to illuminate some of the shifting negotiations and alliances that characterize the rise and shift of direction in rational expectations economics. The Evolving Rationality of Rational Expectations won the 1998 Gunnar Myrdal Prize of the European Association for Evolutionary Political Economy for the best monograph on a theme broadly in accord with the EAEPE Theoretical Perspectives.},
  isbn = {978-0-521-02771-7},
